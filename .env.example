# Usado pelo docker-compose.yml em produção

POSTGRES_USER=painel
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=painel_vendas

ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Domínio real do backend, com HTTPS (ex: https://painel.seudominio.com.br/auth/callback)
ML_REDIRECT_URI=

# URL pública do backend, usada pelo frontend no build (ex: https://painel.seudominio.com.br)
VITE_API_BASE_URL=

# Login do painel (usuário único)
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
JWT_SECRET=

# Chave da API da Anthropic (console.anthropic.com) — usada pelo Agentes IA
# (Analista de Ads). Conta separada do Claude Max, cobrada por uso próprio.
ANTHROPIC_API_KEY=

# Chave da API da OpenAI (platform.openai.com) — usada pelo Agente de
# Imagens (tratar foto de produto / criar arte promocional). Conta separada
# do ChatGPT Plus, cobrada por uso próprio.
OPENAI_API_KEY=

# Número autorizado a falar com o bot de WhatsApp (Growth Hacker) — só
# dígitos em E.164 sem "+" (ex: 5511999999999). Opcional; sem ela, o bot
# fica desligado e o resto do painel funciona normal.
WHATSAPP_OWNER_NUMBER=

# --- Inteligência de Mercado (market-intelligence/) ---
# Banco Postgres próprio, totalmente separado do banco principal.
MARKET_POSTGRES_USER=market
MARKET_POSTGRES_PASSWORD=troque-por-uma-senha-forte
MARKET_POSTGRES_DB=market_intelligence

# Chave de serviço interna (nunca é segredo do ML nem do painel) usada só
# pra autenticar chamadas entre o backend principal e o market-intelligence.
# Gere com: openssl rand -hex 32
INTERNAL_SERVICE_KEY=

# Chave da API da GeckoAPI (geckoapi.com.br) — provider externo de dados de
# mercado do Fase 1. Opcional; sem ela, o serviço sobe mas a busca fica
# indisponível.
GECKO_API_KEY=
