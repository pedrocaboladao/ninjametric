PORT=4000

# Postgres local (ajuste usuário/senha conforme instalado)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/painel_vendas

# Origens extras liberadas no CORS, além de https://ninjametrics.cloud e
# localhost (já liberados por padrão em src/config/env.ts) — separadas por
# vírgula. Só precisa preencher se usar outro domínio (ex: staging).
CORS_ORIGIN=

# App registrado em https://developers.mercadolivre.com.br/ (1 app para as 4 contas)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://localhost:4000/auth/callback

# Login do painel (usuário único)
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
JWT_SECRET=

# Chave da API da Anthropic (console.anthropic.com) — opcional em dev local.
# Sem ela, o Agentes IA (Analista de Ads) cai nas regras fixas em vez da
# análise com IA de verdade.
ANTHROPIC_API_KEY=

# Chave da API da OpenAI (platform.openai.com) — opcional em dev local. Sem
# ela, o Agente de Imagens fica indisponível.
OPENAI_API_KEY=

# Número de WhatsApp autorizado a falar com o bot (Growth Hacker) — só
# dígitos em E.164 sem "+" (ex: 5511999999999). Obrigatório para o backend
# subir; qualquer remetente diferente desse número é ignorado pelo bot.
WHATSAPP_OWNER_NUMBER=
